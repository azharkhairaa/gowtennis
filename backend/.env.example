# Salin jadi .env lalu sesuaikan. File .env jangan di-commit.

ENVIRONMENT=development

# Asal frontend yang boleh memanggil API (pisahkan dengan koma).
CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183

# curated = pakai daftar manual di data/social_feed.json (default, tanpa kredensial)
# api     = tarik otomatis dari Instagram Graph API
FEED_MODE=curated

# Lama cache feed sebelum ditarik ulang (detik). 900 = 15 menit.
FEED_CACHE_TTL=900
FEED_LIMIT=9

# --- Instagram Graph API (isi hanya kalau FEED_MODE=api) ---
# Butuh akun Instagram Professional (Business/Creator) dan Meta App.
# Basic Display API sudah dimatikan 4 Desember 2024, jangan dipakai lagi.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0
